# ============================================================================
# Security headers for static assets.
# Applied by Cloudflare Pages to every response it serves from public/.
# ============================================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'

# Hashed/immutable assets could be cached hard, but these are plain filenames
# that change in place, so keep the window short.
/assets/*
  Cache-Control: public, max-age=300, must-revalidate

/admin
  X-Robots-Tag: noindex, nofollow

/admin/*
  X-Robots-Tag: noindex, nofollow

/img/*
  Cache-Control: public, max-age=31536000, immutable
